---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const capabilities = [
  {
    title: "Read the original",
    body: "Prefer a site's native Markdown, source APIs, and high-quality extraction. Planned for read_link."
  },
  {
    title: "Explore a site",
    body: "Discover relevant URLs without reimplementing web search. Planned for map_site."
  },
  {
    title: "Fallback only",
    body: "Designed to complement native agent browsing and search, not replace either."
  },
  {
    title: "Small surface",
    body: "A stateless Go MCP endpoint on Vercel with API-key authentication. Infrastructure scaffold is ready."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Origo / origin, source</p>
      <h1>A second path to the source.</h1>
      <p class="hero__lede">
        An MCP server built for moments when an agent can find a page but cannot properly read it.
        Origo will focus on direct link retrieval and site mapping, not search.
      </p>
      <p class="hero__annotation">
        Infrastructure preview. The server transport and authentication are scaffolded;
        retrieval features are still being designed.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Endpoint setup</a>
        <a class="button button--ghost" href="/docs/architecture">Architecture</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">The planned MCP interface</p>
      <ul class="hero__signal-list">
        <li><strong>read_link</strong> — a page URL in, useful Markdown out.</li>
        <li><strong>map_site</strong> — discover URLs from a site.</li>
        <li>No search tool. No local CLI. No release packaging.</li>
      </ul>
      <div class="hero__terminal">
        <span>https://api.origo.ashray.xyz/mcp?key=…</span>
        <span>transport: stateless Streamable HTTP</span>
        <span>status: no tools registered yet</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Design principles</p>
      <h2>Optimized for reading. Not another search engine.</h2>
      <p>Origo is intended to preserve the strengths of WebCTX's Markdown and GitHub retrieval while giving agents more ways to access pages when a standard browser fetch falls short.</p>
    </div>
    <div class="proof-grid">
      {capabilities.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>From transport to retrieval.</h2>
      <p>Start with the infrastructure and follow the design decisions before enabling the two tools.</p>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell closing-note">
    <p>Origo is a private, early-stage project. The public docs describe the architecture, not a finished retrieval product.</p>
  </section>
</BaseLayout>
